---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Portfolio from '../components/Portfolio.jsx';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mateo Paredes | Front-End & UX/UI</title>
  </head>
  <body class="bg-[#070708] text-[#F5F5F7] selection:bg-white min-h-screen">
    
    <!-- Filtro de ruido fotográfico de fondo -->
    <div class="studio-grain pointer-events-none fixed inset-0 z-[60] opacity-50 mix-blend-soft-light"></div>
    
    <!-- Componentes -->
    <Header />
    <Portfolio client:load />
    <Footer />
    
  </body>
</html>