---
// src/components/Header.astro
---
<header id="main-header" class="fixed z-50 border-b border-white/10 bg-[#070708]/90 backdrop-blur-xl transition-colors duration-500" style="top: 0; left: 0; width: 100%; box-sizing: border-box;">
  
  <nav class="mx-auto flex w-full max-w-[1720px] items-center justify-between px-6 py-5 md:px-10 md:py-6 lg:px-12" aria-label="Primary navigation">
    
    <!-- Logo Izquierda -->
    <a href="#top" class="font-display font-bold uppercase text-[#F5F5F7] relative z-[60]" style="text-decoration: none; font-size: 14px; letter-spacing: -0.02em;">
      Mateo Paredes / Studio
    </a>

    <!-- Enlaces Centro (Ocultos en móvil) -->
    <div class="hidden md:flex items-center gap-10 font-mono-tech text-[10px] uppercase tracking-[0.2em] text-[#8A8A93]">
      <a href="#work" data-i18n="work" class="transition-colors hover:text-[#F5F5F7]">Proyectos</a>
      <a href="#method" data-i18n="method" class="transition-colors hover:text-[#F5F5F7]">Perfil 360º</a>
      <a href="#archive" data-i18n="archive" class="transition-colors hover:text-[#F5F5F7]">Arte & CV</a>
    </div>

    <!-- Botón Hamburguesa (Visible en móvil) -->
    <button id="hamburger-btn" class="md:hidden flex flex-col justify-center gap-[5px] w-8 h-8 relative z-[60] bg-transparent border-0 cursor-pointer p-1">
      <span class="hamburger-line line-1 w-full h-[1px] bg-[#F5F5F7] block"></span>
      <span class="hamburger-line line-2 w-full h-[1px] bg-[#F5F5F7] block"></span>
      <span class="hamburger-line line-3 w-full h-[1px] bg-[#F5F5F7] block"></span>
    </button>

    <!-- Bloque Derecha: Indicador + Selector Idioma (Oculto en móvil) -->
    <div class="hidden md:flex items-center gap-6">
      <a href="#contact" class="flex items-center gap-2 font-mono-tech text-[10px] uppercase tracking-[0.16em] text-[#8A8A93] transition-colors hover:text-[#F5F5F7]" style="text-decoration: none;">
        <span class="animate-status-pulse rounded-full bg-[#F5F5F7]" style="width: 6px; height: 6px; display: block;"></span>
        <span data-i18n="status">Disponible</span>
      </a>

      <span class="text-white/10 font-mono-tech">|</span>

      <div class="flex items-center gap-1 font-mono-tech text-[10px] tracking-[0.16em] text-[#8A8A93]">
        <button id="lang-es-desktop" class="text-[#F5F5F7] font-bold underline bg-transparent border-0 cursor-pointer transition-colors p-0">ES</button>
        <span>/</span>
        <button id="lang-en-desktop" class="hover:text-[#F5F5F7] bg-transparent border-0 cursor-pointer transition-colors p-0">EN</button>
      </div>
    </div>
  </nav>

  <!-- Cortina del Menú Móvil Premium (AHORA TOTALMENTE CENTRADA) -->
  <div id="mobile-menu" class="mobile-menu-overlay fixed inset-0 bg-[#070708] flex flex-col items-center justify-center px-6 z-40 h-[100svh]">
    
    <div class="flex flex-col items-center text-center gap-8 font-display text-4xl font-bold uppercase tracking-[-0.02em]">
      <a href="#work" data-i18n="workMobile" class="mobile-link text-[#F5F5F7] hover:text-[#8A8A93] transition-colors" style="text-decoration: none;">Proyectos.</a>
      <a href="#method" data-i18n="methodMobile" class="mobile-link text-[#F5F5F7] hover:text-[#8A8A93] transition-colors" style="text-decoration: none;">Perfil 360º.</a>
      <a href="#archive" data-i18n="archiveMobile" class="mobile-link text-[#F5F5F7] hover:text-[#8A8A93] transition-colors" style="text-decoration: none;">Arte & CV.</a>
    </div>
    
    <div class="mt-16 pt-8 border-t border-white/10 flex items-center justify-center gap-3 font-mono-tech text-[10px] uppercase tracking-[0.2em] text-[#8A8A93] w-[220px]">
      <span class="animate-status-pulse rounded-full bg-[#F5F5F7]" style="width: 6px; height: 6px; display: block;"></span>
      <span data-i18n="statusMobile">Estado: Disponible</span>
    </div>

    <!-- CÁPSULA DE IDIOMA MÓVIL -->
    <div class="mt-8 flex items-center justify-center gap-6 font-mono-tech text-[14px] tracking-[0.2em] text-[#8A8A93] border border-white/20 py-4 rounded-full w-[220px]">
      <button id="lang-es-mobile" class="text-[#F5F5F7] font-bold underline bg-transparent border-0 cursor-pointer transition-colors p-0">ES</button>
      <span>/</span>
      <button id="lang-en-mobile" class="hover:text-[#F5F5F7] bg-transparent border-0 cursor-pointer transition-colors p-0">EN</button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('main-header');
  const links = document.querySelectorAll('.mobile-link');
  
  const btnEsMobile = document.getElementById('lang-es-mobile');
  const btnEnMobile = document.getElementById('lang-en-mobile');
  const btnEsDesktop = document.getElementById('lang-es-desktop');
  const btnEnDesktop = document.getElementById('lang-en-desktop');

  const headerDict = {
    es: {
      work: "Proyectos", method: "Perfil 360º", archive: "Arte & CV", status: "Disponible",
      workMobile: "Proyectos.", methodMobile: "Perfil 360º.", archiveMobile: "Arte & CV.", statusMobile: "Estado: Disponible"
    },
    en: {
      work: "Projects", method: "360º Profile", archive: "Art & CV", status: "Available",
      workMobile: "Projects.", methodMobile: "360º Profile.", archiveMobile: "Art & CV.", statusMobile: "Status: Available"
    }
  };

  function updateHeaderLanguage(lang) {
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if(headerDict[lang] && headerDict[lang][key]) el.innerText = headerDict[lang][key];
    });
  }

  function setLanguage(lang) {
    const isEs = lang === 'es';
    const colorActive = 'text-[#F5F5F7]';
    const classBold = 'font-bold';
    const classUnderline = 'underline';
    const colorHover = 'hover:text-[#F5F5F7]';

    if (btnEsMobile && btnEnMobile && btnEsDesktop && btnEnDesktop) {
      if (isEs) {
        btnEsMobile.classList.add(colorActive, classBold, classUnderline);
        btnEsMobile.classList.remove(colorHover);
        btnEnMobile.classList.remove(colorActive, classBold, classUnderline);
        btnEnMobile.classList.add(colorHover);

        btnEsDesktop.classList.add(colorActive, classBold, classUnderline);
        btnEsDesktop.classList.remove(colorHover);
        btnEnDesktop.classList.remove(colorActive, classBold, classUnderline);
        btnEnDesktop.classList.add(colorHover);
      } else {
        btnEnMobile.classList.add(colorActive, classBold, classUnderline);
        btnEnMobile.classList.remove(colorHover);
        btnEsMobile.classList.remove(colorActive, classBold, classUnderline);
        btnEsMobile.classList.add(colorHover);

        btnEnDesktop.classList.add(colorActive, classBold, classUnderline);
        btnEnDesktop.classList.remove(colorHover);
        btnEsDesktop.classList.remove(colorActive, classBold, classUnderline);
        btnEsDesktop.classList.add(colorHover);
      }
    }
    updateHeaderLanguage(lang);
    window.dispatchEvent(new CustomEvent('changeLanguage', { detail: lang }));
  }

  if (btn && menu && header) {
    btn.addEventListener('click', () => {
      btn.classList.toggle('menu-open');
      menu.classList.toggle('is-active');
      if (menu.classList.contains('is-active')) {
        header.style.backgroundColor = 'transparent';
        header.style.borderBottomColor = 'transparent';
      } else {
        setTimeout(() => {
          header.style.backgroundColor = 'rgba(7, 7, 8, 0.9)';
          header.style.borderBottomColor = 'rgba(255, 255, 255, 0.1)';
        }, 500);
      }
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        btn.classList.remove('menu-open');
        menu.classList.remove('is-active');
        setTimeout(() => {
          header.style.backgroundColor = 'rgba(7, 7, 8, 0.9)';
          header.style.borderBottomColor = 'rgba(255, 255, 255, 0.1)';
        }, 500);
      });
    });
  }

  if(btnEsMobile) btnEsMobile.addEventListener('click', () => { setLanguage('es'); setTimeout(() => btn.click(), 400); });
  if(btnEnMobile) btnEnMobile.addEventListener('click', () => { setLanguage('en'); setTimeout(() => btn.click(), 400); });
  if(btnEsDesktop) btnEsDesktop.addEventListener('click', () => setLanguage('es'));
  if(btnEnDesktop) btnEnDesktop.addEventListener('click', () => setLanguage('en'));
</script>