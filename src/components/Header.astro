---
// src/components/Header.astro
---
<header id="main-header" class="fixed z-50 bg-[#070708]/90 backdrop-blur-xl transition-all duration-700 ease-out border-b border-white/10" style="top: 0; left: 0; width: 100%; box-sizing: border-box;">
  
  <nav class="mx-auto flex w-full max-w-[1720px] items-center justify-between px-6 py-4 md:px-10 md:py-5 lg:px-12 transition-all duration-500 ease-out" id="nav-container" aria-label="Primary navigation">
    
    <!-- Logo Izquierda con efecto de escala 3D -->
    <a href="#top" class="relative z-[60] flex items-center group" style="text-decoration: none;">
      <img 
        id="header-logo"
        src="/logotipo.png" 
        alt="Mateo Paredes Studio" 
        class="h-10 md:h-14 w-auto object-contain transition-transform duration-500 cubic-bezier(0.16, 1, 0.3, 1) group-hover:scale-[1.08] origin-left"
      />
    </a>

    <!-- Enlaces Centro (Efecto Hover Premium) -->
    <div class="hidden md:flex items-center gap-10 font-mono-tech text-[10px] uppercase tracking-[0.2em] text-[#8A8A93]">
      <a href="#work" data-i18n="work" class="nav-link relative overflow-hidden group">
        <span class="block transition-transform duration-300 ease-out group-hover:-translate-y-[120%]">Proyectos</span>
        <span class="absolute inset-0 block text-[#F5F5F7] font-bold transition-transform duration-300 ease-out translate-y-[120%] group-hover:translate-y-0">Proyectos</span>
      </a>
      <a href="#method" data-i18n="method" class="nav-link relative overflow-hidden group">
        <span class="block transition-transform duration-300 ease-out group-hover:-translate-y-[120%]">Perfil 360º</span>
        <span class="absolute inset-0 block text-[#F5F5F7] font-bold transition-transform duration-300 ease-out translate-y-[120%] group-hover:translate-y-0">Perfil 360º</span>
      </a>
      <a href="#archive" data-i18n="archive" class="nav-link relative overflow-hidden group">
        <span class="block transition-transform duration-300 ease-out group-hover:-translate-y-[120%]">Arte & CV</span>
        <span class="absolute inset-0 block text-[#F5F5F7] font-bold transition-transform duration-300 ease-out translate-y-[120%] group-hover:translate-y-0">Arte & CV</span>
      </a>
    </div>

    <!-- Botón Hamburguesa Animado -->
    <button id="hamburger-btn" class="md:hidden flex flex-col justify-center gap-[6px] w-8 h-8 relative z-[60] bg-transparent border-0 cursor-pointer p-1" aria-label="Menu">
      <span class="hamburger-line line-1 w-full h-[1px] bg-[#F5F5F7] block transition-all duration-300 ease-in-out"></span>
      <span class="hamburger-line line-2 w-full h-[1px] bg-[#F5F5F7] block transition-all duration-300 ease-in-out"></span>
      <span class="hamburger-line line-3 w-full h-[1px] bg-[#F5F5F7] block transition-all duration-300 ease-in-out"></span>
    </button>

    <!-- Bloque Derecha: Indicador + Selector Idioma -->
    <div class="hidden md:flex items-center gap-6">
      <a href="#contact" class="flex items-center gap-2 font-mono-tech text-[10px] uppercase tracking-[0.16em] text-[#8A8A93] transition-colors hover:text-[#F5F5F7] group" style="text-decoration: none;">
        <span class="relative flex h-[6px] w-[6px]">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-[6px] w-[6px] bg-[#10B981] transition-transform duration-300 group-hover:scale-125"></span>
        </span>
        <span data-i18n="status">Disponible</span>
      </a>

      <span class="text-white/10 font-mono-tech">|</span>

      <div class="flex items-center gap-3 font-mono-tech text-[10px] tracking-[0.16em] text-[#8A8A93]">
        <button id="lang-es-desktop" class="relative text-[#F5F5F7] font-bold bg-transparent border-0 cursor-pointer p-0 group overflow-hidden">
          <span class="relative z-10">ES</span>
          <span class="absolute bottom-0 left-0 w-full h-[1px] bg-[#F5F5F7] transform origin-left transition-transform duration-300 ease-out"></span>
        </button>
        <span class="text-white/20">/</span>
        <button id="lang-en-desktop" class="relative hover:text-[#F5F5F7] bg-transparent border-0 cursor-pointer p-0 group overflow-hidden">
          <span class="relative z-10">EN</span>
          <span class="absolute bottom-0 left-0 w-full h-[1px] bg-[#F5F5F7] transform scale-x-0 origin-right transition-transform duration-300 ease-out group-hover:scale-x-100 group-hover:origin-left"></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Cortina del Menú Móvil Premium (TAMAÑOS RESPONSIVES ARREGLADOS) -->
  <div id="mobile-menu" class="group fixed inset-0 bg-[#070708]/95 backdrop-blur-2xl flex flex-col items-center justify-center px-6 z-40 h-[100svh] opacity-0 pointer-events-none transition-all duration-500 [&.is-active]:opacity-100 [&.is-active]:pointer-events-auto">
    
    <!-- Ajustado el texto de text-5xl a text-3xl sm:text-4xl -->
    <div class="flex flex-col items-center text-center gap-8 font-display text-3xl sm:text-4xl font-extrabold uppercase tracking-[-0.03em] mt-10 w-full">
      <div class="overflow-hidden w-full">
        <a href="#work" data-i18n="workMobile" class="mobile-link block text-[#F5F5F7] hover:text-[#8A8A93] transition-all duration-500 ease-out translate-y-[100%] opacity-0 group-[.is-active]:translate-y-0 group-[.is-active]:opacity-100 whitespace-nowrap" style="transition-delay: 100ms; text-decoration: none;">Proyectos</a>
      </div>
      <div class="overflow-hidden w-full">
        <a href="#method" data-i18n="methodMobile" class="mobile-link block text-[#F5F5F7] hover:text-[#8A8A93] transition-all duration-500 ease-out translate-y-[100%] opacity-0 group-[.is-active]:translate-y-0 group-[.is-active]:opacity-100 whitespace-nowrap" style="transition-delay: 200ms; text-decoration: none;">Perfil 360º</a>
      </div>
      <div class="overflow-hidden w-full">
        <a href="#archive" data-i18n="archiveMobile" class="mobile-link block text-[#F5F5F7] hover:text-[#8A8A93] transition-all duration-500 ease-out translate-y-[100%] opacity-0 group-[.is-active]:translate-y-0 group-[.is-active]:opacity-100 whitespace-nowrap" style="transition-delay: 300ms; text-decoration: none;">Arte & CV</a>
      </div>
    </div>
    
    <div class="mt-16 pt-8 border-t border-white/10 flex items-center justify-center gap-3 font-mono-tech text-[9px] sm:text-[10px] uppercase tracking-[0.2em] text-[#8A8A93] w-[240px] transition-all duration-700 ease-out opacity-0 translate-y-4 group-[.is-active]:opacity-100 group-[.is-active]:translate-y-0" style="transition-delay: 400ms;">
      <span class="relative flex h-[6px] w-[6px]">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-[6px] w-[6px] bg-[#10B981]"></span>
      </span>
      <span data-i18n="statusMobile">Estado: Disponible</span>
    </div>

    <!-- CÁPSULA DE IDIOMA MÓVIL -->
    <div class="mt-8 flex items-center justify-center gap-8 font-mono-tech text-[12px] sm:text-[14px] tracking-[0.2em] text-[#8A8A93] border border-white/10 py-4 rounded-full w-[240px] transition-all duration-700 ease-out opacity-0 translate-y-4 group-[.is-active]:opacity-100 group-[.is-active]:translate-y-0" style="transition-delay: 500ms;">
      <button id="lang-es-mobile" class="text-[#F5F5F7] font-bold underline bg-transparent border-0 cursor-pointer p-0">ES</button>
      <span class="text-white/20">/</span>
      <button id="lang-en-mobile" class="hover:text-[#F5F5F7] bg-transparent border-0 cursor-pointer p-0">EN</button>
    </div>
  </div>
</header>

<style is:global>
  .menu-open .line-1 { transform: translateY(7px) rotate(45deg); }
  .menu-open .line-2 { opacity: 0; }
  .menu-open .line-3 { transform: translateY(-7px) rotate(-45deg); }
</style>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('main-header');
  const navContainer = document.getElementById('nav-container');
  const links = document.querySelectorAll('.mobile-link');
  
  const btnEsMobile = document.getElementById('lang-es-mobile');
  const btnEnMobile = document.getElementById('lang-en-mobile');
  const btnEsDesktop = document.getElementById('lang-es-desktop');
  const btnEnDesktop = document.getElementById('lang-en-desktop');

  const headerDict = {
    es: {
      work: "Proyectos", method: "Perfil 360º", archive: "Arte & CV", status: "Disponible",
      workMobile: "Proyectos", methodMobile: "Perfil 360º", archiveMobile: "Arte & CV", statusMobile: "Estado: Disponible"
    },
    en: {
      work: "Projects", method: "360º Profile", archive: "Art & CV", status: "Available",
      workMobile: "Projects", methodMobile: "360º Profile", archiveMobile: "Art & CV", statusMobile: "Status: Available"
    }
  };

  function updateHeaderLanguage(lang) {
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if(headerDict[lang] && headerDict[lang][key]) {
        if(el.classList.contains('nav-link')) {
          el.children[0].innerText = headerDict[lang][key];
          el.children[1].innerText = headerDict[lang][key];
        } else {
          el.innerText = headerDict[lang][key];
        }
      }
    });
  }

  function setLanguage(lang) {
    const isEs = lang === 'es';
    
    if(btnEsDesktop && btnEnDesktop) {
      if (isEs) {
        btnEsDesktop.classList.add('text-[#F5F5F7]', 'font-bold');
        btnEsDesktop.querySelector('span:last-child').style.transform = 'scaleX(1)';
        btnEnDesktop.classList.remove('text-[#F5F5F7]', 'font-bold');
        btnEnDesktop.querySelector('span:last-child').style.transform = 'scaleX(0)';
      } else {
        btnEnDesktop.classList.add('text-[#F5F5F7]', 'font-bold');
        btnEnDesktop.querySelector('span:last-child').style.transform = 'scaleX(1)';
        btnEsDesktop.classList.remove('text-[#F5F5F7]', 'font-bold');
        btnEsDesktop.querySelector('span:last-child').style.transform = 'scaleX(0)';
      }
    }
    
    if (btnEsMobile && btnEnMobile) {
      if (isEs) {
        btnEsMobile.classList.add('text-[#F5F5F7]', 'font-bold', 'underline');
        btnEnMobile.classList.remove('text-[#F5F5F7]', 'font-bold', 'underline');
      } else {
        btnEnMobile.classList.add('text-[#F5F5F7]', 'font-bold', 'underline');
        btnEsMobile.classList.remove('text-[#F5F5F7]', 'font-bold', 'underline');
      }
    }

    updateHeaderLanguage(lang);
    window.dispatchEvent(new CustomEvent('changeLanguage', { detail: lang }));
  }

  if (btn && menu && header) {
    btn.addEventListener('click', () => {
      btn.classList.toggle('menu-open');
      menu.classList.toggle('is-active');
      
      // BLOQUEA EL SCROLL DE LA PÁGINA CUANDO EL MENÚ ESTÁ ABIERTO
      if (menu.classList.contains('is-active')) {
        document.body.style.overflow = 'hidden';
        header.style.backgroundColor = 'transparent';
        header.style.borderBottomColor = 'transparent';
      } else {
        document.body.style.overflow = '';
        setTimeout(() => {
          header.style.backgroundColor = 'rgba(7, 7, 8, 0.9)';
          header.style.borderBottomColor = 'rgba(255, 255, 255, 0.1)';
        }, 500);
      }
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        btn.classList.remove('menu-open');
        menu.classList.remove('is-active');
        document.body.style.overflow = ''; // RESTABLECE EL SCROLL AL HACER CLICK EN UN ENLACE
        setTimeout(() => {
          header.style.backgroundColor = 'rgba(7, 7, 8, 0.9)';
          header.style.borderBottomColor = 'rgba(255, 255, 255, 0.1)';
        }, 500);
      });
    });
  }

  if(btnEsMobile) btnEsMobile.addEventListener('click', () => { setLanguage('es'); setTimeout(() => btn.click(), 400); });
  if(btnEnMobile) btnEnMobile.addEventListener('click', () => { setLanguage('en'); setTimeout(() => btn.click(), 400); });
  if(btnEsDesktop) btnEsDesktop.addEventListener('click', () => setLanguage('es'));
  if(btnEnDesktop) btnEnDesktop.addEventListener('click', () => setLanguage('en'));

  // --- SMART HEADER SCROLL (Solo encoge, ya NO desaparece nunca) ---
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    const logo = document.getElementById('header-logo');
    
    // Filtro del logo (Blanco/Negro)
    if (logo) {
      if (currentScroll > 50) {
        logo.style.filter = 'brightness(0) invert(1)';
      } else {
        logo.style.filter = 'none';
      }
    }

    // Encoger la barra al hacer scroll (Efecto cristal dinámico)
    if (currentScroll > 100) {
      navContainer.classList.remove('py-4', 'md:py-5');
      navContainer.classList.add('py-2', 'md:py-3');
    } else {
      navContainer.classList.add('py-4', 'md:py-5');
      navContainer.classList.remove('py-2', 'md:py-3');
    }
  });
</script>