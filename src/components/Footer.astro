            </svg>
          </a>
        </div>

      </div>
    </div>

    <!-- Créditos inferiores (CENTRADOS EN MÓVIL) -->
    <div class="flex flex-col md:flex-row items-center justify-between border-t border-[#070708]/10 pt-6 font-mono-tech text-[9px] uppercase tracking-[0.14em] text-[#8A8A93] gap-4 text-center md:text-left scroll-card" style="transition-delay: 600ms;">
      <span>© 2026 MATEO PAREDES / STUDIO. ALL RIGHTS RESERVED.</span>
      <span class="hidden md:inline">DESIGN SYSTEMS × FRONT-END × UX/UI</span>
      <a href="#top" class="text-[#070708] hover:opacity-50 transition-opacity font-bold">BACK TO TOP ↑</a>
    </div>
  </div>
</footer>

<script>
  // Script Vanilla JS para Efectos Avanzados del Footer
  document.addEventListener("DOMContentLoaded", () => {
    
    // 1. EFECTO MAGNÉTICO PARA ICONOS DE REDES SOCIALES
    const magneticBtns = document.querySelectorAll('.magnetic-btn');
    
    magneticBtns.forEach((btn) => {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        // Calculamos la distancia al centro del botón
        const x = (e.clientX - rect.left - rect.width / 2) * 0.4;
        const y = (e.clientY - rect.top - rect.height / 2) * 0.4;
        
        // Mueve el botón sutilmente. Usamos transformaciones rápidas.
        btn.style.transform = `translate(${x}px,${y}px) scale(1.1)`;
        btn.style.transition = 'transform 0.1s ease-out'; 
      });

      btn.addEventListener('mouseleave', () => {
        // Vuelve a su estado natural (clase de Tailwind hover:-translate-y-1)
        btn.style.transform = `translate(0px, 0px) scale(1)`;
        btn.style.transition = 'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
      });
    });

    // 2. PARALLAX SUTIL DEL LOGO EN EL CONTENEDOR DERECHO
    const zone = document.getElementById('magnetic-footer-zone');
    const logo = document.getElementById('parallax-logo');
    
    if (zone && logo) {
      zone.addEventListener('mousemove', (e) => {
        const rect = zone.getBoundingClientRect();
        // El logo se mueve muy suavemente en contra o a favor del cursor
        const x = (e.clientX - rect.left - rect.width / 2) * -0.02;
        const y = (e.clientY - rect.top - rect.height / 2) * -0.02;
        
        logo.style.transform = `translate(${x}px,${y}px)`;
        logo.style.transition = 'transform 0.15s ease-out';
      });

      zone.addEventListener('mouseleave', () => {
        logo.style.transform = `translate(0px, 0px)`;
        logo.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
      });
    }
  });
</script>