---
// src/components/Footer.astro
---
<footer id="contact" class="bg-[#F5F5F7] text-[#070708] pt-24 pb-12 px-5 md:px-10 lg:px-12 overflow-hidden">
  <div class="mx-auto max-w-[1720px]">
    <!-- Etiqueta superior -->
    <p class="font-mono-tech text-[10px] uppercase tracking-[0.2em] text-[#8A8A93] mb-12 scroll-card">
      04 / Commission inquiry
    </p>

    <!-- Contenedor principal del texto gigante y contacto -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end mb-32">
      
      <!-- Texto gigante -->
      <div class="lg:col-span-8">
        <h2 class="font-display text-[clamp(2.5rem,10vw,11rem)] font-extrabold uppercase leading-[0.85] tracking-[-0.04em] text-[#070708] break-words scroll-card">
          Let's make<br/>something<br/>exact.
        </h2>
      </div>
      
      <!-- Bloque derecho de contacto (CONTENEDOR MAGNÉTICO/PARALLAX) -->
      <div id="magnetic-footer-zone" class="lg:col-span-4 flex flex-col justify-end pb-4 relative z-10">
        
        <!-- LOGOTIPO (Parallax suave) -->
        <img 
          id="parallax-logo"
          src="/logofooter.png" 
          alt="Mateo Studio Logo" 
          class="w-50 md:w-72 lg:w-80 mb-10 mx-auto scroll-card will-change-transform"
          style="transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.9s ease-out; transition-delay: 200ms;"
        />

        <p class="text-sm md:text-base leading-relaxed text-[#52525B] mb-8 max-w-sm scroll-card" style="transition-delay: 300ms;">
          Selected collaborations for digital products, cultural commissions, and editorial image-making.
        </p>
        
        <a href="mailto:mateoparedes082@gmail.com" class="scroll-card group flex items-center justify-between border-y border-[#070708]/10 py-5 font-mono-tech text-[10px] uppercase tracking-[0.14em] text-[#070708] transition-colors hover:border-[#070708]/30" style="transition-delay: 400ms;">
          mateoparedes082@gmail.com
