          <!-- LinkedIn -->
          <a href="https://linkedin.com/in/mateo-paredes-vega-design/" target="_blank" rel="noopener noreferrer" class="magnetic-btn text-[#070708] hover:text-[#8A8A93] transition-colors p-2 -m-2 block will-change-transform">
