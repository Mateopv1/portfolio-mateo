---
// src/components/FloatingContact.astro
const { lang = 'es' } = Astro.props;
const label = lang === 'en' ? 'Contact' : 'Contacto';
---

<a
  id="floating-contact-btn"
  href="#contact"
  aria-label="Ir a contacto"
  class="fixed bottom-5 right-5 md:bottom-8 md:right-8 z-[40] flex items-center gap-2.5 px-4 py-3 bg-[#070708]/90 border border-[#FD7B34] text-[#F5F5F7] hover:bg-[#FD7B34] hover:text-[#070708] font-mono-tech text-[10px] uppercase tracking-[0.18em] shadow-[0_8px_30px_rgba(0,0,0,0.6)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-0 translate-y-4 pointer-events-none group"
>
  <span class="w-1.5 h-1.5 rounded-full bg-[#FD7B34] group-hover:bg-[#070708] transition-colors"></span>
  <span id="floating-contact-label">{label}</span>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-y-0.5"
  >
    <path d="M12 5v14M19 12l-7 7-7-7" />
  </svg>
</a>

<script>
  const btn = document.getElementById('floating-contact-btn');
  const labelEl = document.getElementById('floating-contact-label');
  const footer = document.getElementById('contact');

  if (btn) {
    let pastHero = false;
    let footerVisible = false;

    const updateVisibility = () => {
      const show = pastHero && !footerVisible;
      btn.classList.toggle('opacity-100', show);
      btn.classList.toggle('translate-y-0', show);
      btn.classList.toggle('pointer-events-auto', show);
      btn.classList.toggle('opacity-0', !show);
      btn.classList.toggle('translate-y-4', !show);
      btn.classList.toggle('pointer-events-none', !show);
    };

    // 1. Detectar cuándo hemos bajado del Hero
    const onScroll = () => {
      const nextPastHero = window.scrollY > 360;
      if (nextPastHero !== pastHero) {
        pastHero = nextPastHero;
        updateVisibility();
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // 2. Ocultar automáticamente al entrar en el Footer (#contact)
    if (footer) {
      const footerObserver = new IntersectionObserver(
        ([entry]) => {
          footerVisible = entry.isIntersecting;
          updateVisibility();
        },
        { threshold: 0.08 }
      );
      footerObserver.observe(footer);
    }

    // 3. Soporte bilingüe dinámico
    window.addEventListener('changeLanguage', (e) => {
      if (!labelEl || !e.detail) return;
      labelEl.textContent = e.detail === 'en' ? 'Contact' : 'Contacto';
    });
  }
</script>